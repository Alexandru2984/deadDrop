[Unit]
Description=Dead Drop — auto-regenerate code-integrity manifest on web/ changes
After=deaddrop.service

[Service]
Type=simple
User=micu
Group=micu
WorkingDirectory=/home/micu/deaddrop
ExecStart=/usr/bin/node scripts/watch-integrity.mjs
Restart=always
RestartSec=5

# Hardening: it only ever writes the manifest + HTML under the repo.
NoNewPrivileges=true
ProtectSystem=full
PrivateTmp=true
ReadWritePaths=/home/micu/deaddrop/web

[Install]
WantedBy=multi-user.target
