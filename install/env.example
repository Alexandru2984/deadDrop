# Dead Drop settings. setup.sh copies this to .env and fills it in; edit .env
# afterwards and run `docker compose up -d` to apply. Keep .env private: it
# holds the TURN secret.

# The address people will use, without https://. Its DNS must point at this
# server before the first start, or the HTTPS certificate cannot be issued.
DOMAIN=chat.example.org

# Where to report a vulnerability in this installation, published at
# /.well-known/security.txt. A mailto: or https: address; empty publishes none.
SECURITY_CONTACT=

# New accounts need a single-use invite (`docker compose exec app deaddrop
# invite`). They stop working after this many days; 0 keeps them forever.
INVITE_TTL_DAYS=14
# 1 lets anyone register without an invite. Not recommended.
OPEN_REGISTRATION=0

# ── Calls through a relay (optional, recommended) ──
# Without a relay, calls work only when the two browsers can reach each other
# directly — often not the case on mobile networks. To run one, uncomment the
# lines below (setup.sh --turn does it for you) and open in the firewall:
# 3478/udp, 3478/tcp and 49160-49999/udp.
#
# TURN_HOST must reach this server directly: if DOMAIN goes through a proxy
# such as Cloudflare, use a separate DNS-only name for it.
#COMPOSE_PROFILES=turn
#PUBLIC_IP=203.0.113.5
#TURN_SECRET=
#TURN_URLS=turn:chat.example.org:3478?transport=udp,turn:chat.example.org:3478?transport=tcp
#STUN_URLS=stun:chat.example.org:3478

# ── Rarely changed ──
# Ports to publish on the host, and on which address.
#BIND_ADDRESS=0.0.0.0
#HTTP_PORT=80
#HTTPS_PORT=443
# Set only when people reach the site at something other than https://DOMAIN.
#PUBLIC_ORIGIN=
