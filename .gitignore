# Go binaries. The glob matters: deploy and rollback steps produce siblings
# like deaddrop.rollback or deaddrop.new, and a bare /deaddrop would let a
# 10 MB build artefact ride into a commit unnoticed.
/deaddrop
/deaddrop.*
/server
*.exe
*.exe~
*.dll
*.so
*.dylib

# Go test/coverage
*.test
*.out
coverage.html

# Go workspace
go.work
go.work.sum

# IDE
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store

# Environment
.env
.env.local

# Build output
/bin/
/dist/

# User data (password hashes)
data/
